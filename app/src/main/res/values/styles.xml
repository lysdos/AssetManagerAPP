<resources>
    <style name="Huaxia.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/cardCornerRadius</item>
        <item name="cardElevation">@dimen/cardElevation</item>
        <item name="cardBackgroundColor">@color/cardCorner</item>
    </style>

    <style name="Huaxia.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/colorPrimary</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="subtitleTextColor">@android:color/white</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Huaxia.StatNumber" parent="">
        <item name="android:textSize">@dimen/statNumberSize</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Huaxia.StatLabel" parent="">
        <item name="android:textSize">@dimen/textSizeLabel</item>
        <item name="android:textColor">@color/textHint</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Huaxia.StatSub" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/textLightHint</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Huaxia.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemTextAppearance">@style/Huaxia.BottomNav.Text</item>
    </style>

    <style name="Huaxia.BottomNav.Text" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Asset detail dialog: field label (灰色小字) -->
    <style name="DialogLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textSize">@dimen/textSizeLabel</item>
        <item name="android:textColor">@color/textHint</item>
    </style>

    <!-- Asset detail dialog: read-only value (默认黑字) -->
    <style name="DialogValue" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <!-- Inline row label/value (used inside CardView detail sections). -->
    <style name="RowLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/textHint</item>
    </style>

    <style name="RowValue" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">2</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <!-- 资产总览: 类型筛选 chip -->
    <style name="Huaxia.AssetTypeChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/asset_chip_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="chipBackgroundColor">@color/asset_chip_bg</item>
        <item name="chipStrokeColor">@color/asset_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- 资产总览: 可关闭的筛选标签 -->
    <style name="Huaxia.AssetFilterChip" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/tagBlueFg</item>
        <item name="android:textAllCaps">false</item>
        <item name="chipBackgroundColor">@color/tagBlueBg</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">30dp</item>
        <item name="closeIconVisible">true</item>
        <item name="closeIcon">@drawable/ic_close</item>
        <item name="closeIconTint">@color/tagBlueFg</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>
</resources>
