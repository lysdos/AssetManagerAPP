<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 完成任务：仅对 进行中/已暂停 显示 (由 Fragment 按 status 控制可见性)。语义 =
         status -> COMPLETED, 不可逆; 完成后的任务可被"清除已完成"清理。 -->
    <item
        android:id="@+id/menu_task_complete"
        android:title="@string/task_action_complete"
        android:icon="@drawable/ic_check" />
    <!-- 删除任务：所有状态都显示。语义 = 释放资产回库存池 + 清扫描 + 删任务壳 + 清 session. -->
    <item
        android:id="@+id/menu_task_delete"
        android:title="@string/task_action_delete"
        android:icon="@drawable/ic_close" />
</menu>
