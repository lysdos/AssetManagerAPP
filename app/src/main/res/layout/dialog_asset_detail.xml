<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:background="@color/cardCorner">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView style="@style/DialogLabel"
            android:text="@string/label_epc" />
        <TextView android:id="@+id/dlgEpcTv"
            style="@style/DialogValue" />

        <TextView style="@style/DialogLabel"
            android:text="@string/label_asset_name" />
        <TextView android:id="@+id/dlgNameTv"
            style="@style/DialogValue" />

        <TextView style="@style/DialogLabel"
            android:text="@string/label_asset_type" />
        <TextView android:id="@+id/dlgTypeTv"
            style="@style/DialogValue" />

        <TextView style="@style/DialogLabel"
            android:text="@string/label_asset_model" />
        <TextView android:id="@+id/dlgModelTv"
            style="@style/DialogValue" />

        <TextView style="@style/DialogLabel"
            android:text="@string/label_org" />
        <TextView android:id="@+id/dlgOrgTv"
            style="@style/DialogValue" />

        <TextView style="@style/DialogLabel"
            android:text="@string/label_detailed_location" />
        <TextView android:id="@+id/dlgDetailedLocationTv"
            style="@style/DialogValue" />

        <TextView style="@style/DialogLabel"
            android:text="@string/label_placement_location" />
        <TextView android:id="@+id/dlgPlacementLocationTv"
            style="@style/DialogValue" />

        <TextView style="@style/DialogLabel"
            android:text="@string/label_asset_status" />
        <TextView android:id="@+id/dlgAssetStatusTv"
            style="@style/DialogValue" />

        <TextView style="@style/DialogLabel"
            android:text="@string/label_inventory_status" />
        <TextView android:id="@+id/dlgInventoryStatusTv"
            style="@style/DialogValue" />

        <TextView style="@style/DialogLabel"
            android:text="@string/label_inventory_time" />
        <TextView android:id="@+id/dlgInventoryTimeTv"
            style="@style/DialogValue" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:background="@color/borderDashed" />

        <TextView style="@style/DialogLabel"
            android:text="@string/label_borrow_dept" />
        <EditText
            android:id="@+id/dlgBorrowDeptEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_borrow_dept"
            android:textSize="15sp"
            android:textColor="@android:color/black"
            android:textColorHint="@color/textLightHint"
            android:inputType="text"
            android:maxLines="1"
            android:autofillHints="organizationName" />

        <TextView style="@style/DialogLabel"
            android:layout_marginTop="10dp"
            android:text="@string/label_borrower" />
        <EditText
            android:id="@+id/dlgBorrowerEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_borrower"
            android:textSize="15sp"
            android:textColor="@android:color/black"
            android:textColorHint="@color/textLightHint"
            android:inputType="text"
            android:maxLines="1"
            android:autofillHints="personName" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dlgCancelBtn"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dlgSaveBtn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/action_save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
