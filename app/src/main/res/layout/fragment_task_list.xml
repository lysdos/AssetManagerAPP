<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bgSurface">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/cardPadding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/task_title"
                android:textSize="@dimen/textSizeTitle"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <include
                    android:id="@+id/summaryTotal"
                    layout="@layout/view_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp" />

                <include
                    android:id="@+id/summaryProgress"
                    layout="@layout/view_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp" />

                <include
                    android:id="@+id/summaryDone"
                    layout="@layout/view_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp" />
            </LinearLayout>

            <!--
              任务卡片容器用普通 LinearLayout, 不用 RecyclerView:
              RecyclerView 自带滚动, 以 wrap_content 嵌在 ScrollView 里时, 它的 auto-measure
              会拿"可用视口高度"当排布预算 —— 内容一旦超过视口, 之后新增的卡片会被静默丢弃
              (既不排布也不撑高, 所以滑到底也看不到)。任务数量是个位数, item 复用本来也无意义,
              整页滚动交给外层 ScrollView。
            -->
            <LinearLayout
                android:id="@+id/taskListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/taskEmptyTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="@string/task_empty"
                android:textSize="@dimen/textSizeBody"
                android:textColor="@color/textHint"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/cardCorner"
        android:elevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/taskCreateBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/task_create_btn" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/taskClearDoneBtn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/task_clear_done"
            android:textColor="@color/colorReset"
            app:strokeColor="@color/colorReset" />
    </LinearLayout>
</LinearLayout>