<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="20dp">

        <!-- Title bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/task_create_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <ImageButton
                android:id="@+id/taskCloseBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_dialog_close"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/action_cancel"
                android:scaleType="centerInside" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#eeeeee" />

        <!-- Task name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_name_label"
                android:textSize="14sp"
                android:textColor="#333333" />

            <EditText
                android:id="@+id/taskNameEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_input_focused"
                android:hint="@string/task_name_placeholder"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:textSize="15sp"
                android:textColor="#222222"
                android:textColorHint="#999999" />
        </LinearLayout>

        <!-- Department (optional) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_dept_label_optional"
                android:textSize="14sp"
                android:textColor="#333333" />

            <Spinner
                android:id="@+id/taskDeptSp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_input"
                android:padding="10dp" />

            <TextView
                android:id="@+id/taskPreviewTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:textColor="#888888"
                tools:text="将盘点 0 台" />
        </LinearLayout>

        <!-- Remark (optional) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_remark_label"
                android:textSize="14sp"
                android:textColor="#333333" />

            <EditText
                android:id="@+id/taskRemarkEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_input_focused"
                android:hint="@string/task_remark_placeholder"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:textSize="15sp"
                android:textColor="#222222"
                android:textColorHint="#999999" />
        </LinearLayout>

        <!-- Footer buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/taskCancelBtn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_cancel"
                android:textColor="#666666"
                app:strokeColor="#dddddd" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/taskSaveBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/task_create_confirm"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>