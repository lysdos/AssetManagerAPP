<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cardCorner"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/deptDialogSearchEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_input"
        android:hint="@string/asset_dept_dialog_search_hint"
        android:inputType="text"
        android:padding="10dp"
        android:singleLine="true"
        android:textColor="#333333"
        android:textColorHint="@color/textHint"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/deptDialogListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/deptDialogEmptyTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/asset_dept_dialog_empty"
        android:textColor="@color/textHint"
        android:textSize="14sp"
        android:visibility="gone"
        tools:visibility="gone" />
</LinearLayout>
