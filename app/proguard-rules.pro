-keep class org.apache.xmlbeans.XmlBoolean { *; }
-keep class org.apache.xmlbeans.XmlLong { *; }
-keep class org.apache.xmlbeans.XmlDateTime { *; }
-keep class org.apache.xmlbeans.XmlBase64Binary { *; }
-keep class org.apache.xmlbeans.XmlAnySimpleType { *; }
-keep class org.apache.xmlbeans.XmlToken { *; }
-keep class org.apache.xmlbeans.SchemaType { *; }
