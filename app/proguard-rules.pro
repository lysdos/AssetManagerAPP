-dontwarn org.apache.logging.log4j.core.appender.jms.**
-dontwarn org.apache.logging.log4j.core.appender.db.**
-dontwarn org.apache.logging.log4j.core.appender.mom.jeromq.**

# log4j-core 引用但可选: jansi(彩色终端) / jctools(高性能队列)
# commons-compress 引用但可选: tukaani(xz/lzma 压缩, POI 只用 zip 不用 xz)
-dontwarn org.fusesource.jansi.**
-dontwarn org.jctools.**
-dontwarn org.tukaani.**

# log4j-core 内置: PluginProcessor(编译期注解处理器, runtime 不会跑)
# log4j-core 可选 layout: AbstractCsvLayout(commons-csv) / JacksonFactory(stax2)
# Android runtime 不带 javax.tools / javax.xml.stream
-dontwarn javax.tools.**
-dontwarn javax.xml.stream.**
-dontwarn org.apache.commons.csv.**
-dontwarn org.codehaus.stax2.**

# log4j-core 引用 JDK 企业包 (Android 不带): JMX / JNDI / Scripting
